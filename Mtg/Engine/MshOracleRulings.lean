    cards := #["Fin Fang Foom", "Loki Laufeyson"],
    sets := #["msh"] },
  { id := 68, comment := "You pay all costs and follow all normal timing rules for cards played this way. For example, if an exiled card is a land card, you may play it only during your main phase while the stack is empty.",

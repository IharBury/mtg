    cards := #["The Mind Stone"],
    sets := #["msh"] },
  { id := 71, comment := "\"Shield\" is not an ability that creatures have and shield counters are not keyword counters. If a creature with a shield counter loses its abilities, the shield counter will still protect it as normal.",

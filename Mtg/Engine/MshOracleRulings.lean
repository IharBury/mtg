def uniqueMshOracleRulingCount : Nat := uniqueMshOracleRulings.size

#guard uniqueMshOracleRulingCount == 376
#guard uniqueMshOracleRulings[0]!.id == 1
#guard uniqueMshOracleRulings.back!.id == 376
#guard (uniqueMshOracleRulings.map (·.id)).toList ==
  (List.range uniqueMshOracleRulingCount).map (· + 1)
#guard
  (CardDef.uniqueStrings (uniqueMshOracleRulings.toList.map (·.comment))).length ==
    uniqueMshOracleRulingCount
#guard uniqueMshOracleRulings.all (fun r => !r.cards.isEmpty)
#guard uniqueMshOracleRulings.all (fun r => r.sets.any (· == "msh"))


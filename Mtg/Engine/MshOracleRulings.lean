    sets := #["msh"] },
  { id := 64, comment := "Triggered abilities use the word \"when,\" \"whenever,\" or \"at.\" They're often written as \"[Trigger condition], [effect].\" Some keywords (such as prowess) are triggered abilities and will use \"when,\" \"whenever,\" or \"at\" in their reminder text.",
    cards := #["Echo, Perceptive Prodigy", "Scientist Supreme of A.I.M."],
    sets := #["msh"] },
  { id := 65, comment := "When calculating a spell's total cost, include any alternative costs, additional costs, or anything else that increases or reduces the cost to cast the spell. Improvise applies after the total cost is calculated.",
    cards := #["Arc Reactor", "Ironheart, Clever Champion"],
    sets := #["msh"] },
  { id := 66, comment := "You can't choose to pay any activation costs for the copy. However, effects based on those costs that were paid for the original ability are copied as though those same costs were paid for the copy.",
